# ============================================================================
# TotalAssist — Production Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# All variables marked [REQUIRED] must be set before deploying to production.
# Variables marked [OPTIONAL] have sensible defaults shown in comments.
# ============================================================================

# --- Core Infrastructure ---------------------------------------------------

# [REQUIRED] PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/totalassist

# [REQUIRED in production] Must be set or server will refuse to start.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# [REQUIRED] Set to "production" to enable CSP, CORS lockdown, disable test
# endpoints, and enforce session secret requirement.
NODE_ENV=production

# --- Authentication (Google OAuth / Replit OIDC) ---------------------------

# [REQUIRED] Google OAuth 2.0 credentials (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [REQUIRED on Replit] Automatically set by Replit; used as OAuth client ID
REPL_ID=

# [OPTIONAL] Override OAuth callback URL. If unset, derived from REPLIT_DOMAINS.
# CALLBACK_URL=https://totalassist.tech/api/callback

# [OPTIONAL] Comma-separated Replit deployment domains (set automatically by Replit)
# REPLIT_DOMAINS=

# [OPTIONAL] Set to "1" on Replit production deployments (set automatically by Replit)
# REPLIT_DEPLOYMENT=1

# [OPTIONAL] OpenID Connect issuer URL
# Default: https://replit.com/oidc
# ISSUER_URL=https://replit.com/oidc

# --- AI Services -----------------------------------------------------------

# [REQUIRED] Google Gemini 2.0 Flash API key (aistudio.google.com)
GEMINI_API_KEY_TOTALASSIST=

# --- Payments (Stripe) -----------------------------------------------------

# [REQUIRED] Stripe live-mode secret key (starts with sk_live_)
# ⚠️  Do NOT use test keys (sk_test_) in production
STRIPE_SECRET_KEY=

# [REQUIRED] Stripe live-mode publishable key (starts with pk_live_)
# ⚠️  Do NOT use test keys (pk_test_) in production
STRIPE_PUBLISHABLE_KEY=

# [REQUIRED] Stripe webhook signing secret for live-mode events (starts with whsec_)
# Create at: dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# [OPTIONAL] Stripe coupon ID for retention offers
# Default: STAY20
# STRIPE_RETENTION_COUPON_ID=STAY20

# --- Email (Resend) --------------------------------------------------------

# [REQUIRED] Resend API key (resend.com/api-keys)
# ⚠️  Without this, all emails fail silently in production (simulation mode).
# Verify that support@totalassist.tech domain is authenticated in Resend dashboard.
RESEND_API_KEY=

# [OPTIONAL] Sender address for transactional emails
# Default: TotalAssist <support@totalassist.tech>
# EMAIL_FROM=TotalAssist <support@totalassist.tech>

# [OPTIONAL] Email address for escalated case notifications
# Default: support@totalassist.tech
# SPECIALIST_EMAIL=support@totalassist.tech

# --- Domain & URLs ---------------------------------------------------------

# [OPTIONAL] Comma-separated production domains for CORS allowlist
# Default: totalassist.tech
# APP_DOMAINS=totalassist.tech

# [OPTIONAL] Base URL for links in emails and case reports
# Default: https://totalassist.tech
# APP_URL=https://totalassist.tech

# --- Admin Bootstrap -------------------------------------------------------

# [OPTIONAL] Comma-separated admin emails for initial agent portal access.
# Remove this after promoting your first admin via the Agent Portal's role
# management UI — it is a bootstrap-only backdoor.
# ADMIN_EMAILS=you@example.com

# --- PDF Generation --------------------------------------------------------

# [OPTIONAL] Explicit path to Chromium binary for Puppeteer PDF generation.
# If unset, auto-detected from Nix store, cached paths, or system PATH.
# CHROMIUM_PATH=/nix/store/.../chromium
